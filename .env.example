# Copie para .env e ajuste com sua instância PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financas?schema=public"

# Acesso ao painel (padrão: admin / admin123)
AUTH_USER="admin"
AUTH_PASSWORD="admin123"
# Segredo para assinar o cookie de sessão (gere com: openssl rand -hex 32)
AUTH_SECRET=""
