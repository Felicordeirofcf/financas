// Gestão Financeira Pessoal — schema PostgreSQL
// Valores monetários em Decimal(12,2) para evitar erros de ponto flutuante.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseGroup {
  CARTOES
  EMPRESTIMOS
  MORADIA_FIXAS
  TERCEIROS
}

enum IncomeType {
  RECORRENTE
  PONTUAL
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periods    Period[]
  incomes    Income[]
  categories ExpenseCategory[]
}

/// Competência (ex.: "Out/26"). `order` define a sequência no dashboard.
model Period {
  id     String @id @default(cuid())
  userId String
  label  String
  year   Int
  month  Int // 1-12
  order  Int

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseEntries  ExpenseEntry[]
  pontualIncomes  Income[]         @relation("IncomeAllocation")

  @@unique([userId, year, month])
  @@index([userId, order])
}

/// Receita. RECORRENTE vale todo mês; PONTUAL entra uma vez no período alocado.
model Income {
  id                 String     @id @default(cuid())
  userId             String
  name               String
  type               IncomeType @default(RECORRENTE)
  amount             Decimal    @db.Decimal(12, 2)
  allocatedPeriodId  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocatedPeriod Period? @relation("IncomeAllocation", fields: [allocatedPeriodId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Categoria/linha de despesa (ex.: "Cartão Nubank").
model ExpenseCategory {
  id           String       @id @default(cuid())
  userId       String
  name         String
  group        ExpenseGroup
  isThirdParty Boolean      @default(false) // valor apenas transita pela conta
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ExpenseEntry[]
  debt    DebtProfile?

  @@unique([userId, name])
  @@index([userId, group])
}

/// Valor de uma categoria em uma competência.
model ExpenseEntry {
  id         String  @id @default(cuid())
  categoryId String
  periodId   String
  amount     Decimal @db.Decimal(12, 2)

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  period   Period          @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([categoryId, periodId])
  @@index([periodId])
}

/// Premissas de dívida usadas pelo Otimizador de Alocação (Avalanche × Bola de Neve).
model DebtProfile {
  id                 String  @id @default(cuid())
  categoryId         String  @unique
  outstandingBalance Decimal @db.Decimal(12, 2) // saldo devedor estimado
  monthlyRatePct     Decimal @db.Decimal(6, 3) // juros % a.m.

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
